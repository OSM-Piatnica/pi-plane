# Backend
# SECRET_KEY (Django) is not listed here on purpose: ./setup.sh generates a random one and appends it below.
# For a real deployment set your own unique value; known placeholder values are refused at startup.
# Debug value for api server use it as 0 for production use
DEBUG=0
# Browser writes that use the session cookie (everything the web, admin and Space apps send) are only accepted when
# their Origin is the API's own host, WEB_URL, APP_BASE_URL, ADMIN_BASE_URL, SPACE_BASE_URL, LIVE_BASE_URL or one of
# the CORS_ALLOWED_ORIGINS below. Add the address people really use if it differs from all of those.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100"

# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="plane-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_URL="redis://${REDIS_HOST}:6379/"
# rediss:// only: the server certificate and hostname are verified by default.
# Set REDIS_SSL_CA_CERTS to a CA bundle path for a private CA, or REDIS_SSL_CERT_REQS="none" to skip verification.
# REDIS_SSL_CA_CERTS is a path inside the container: mount the CA bundle into the
# api, worker, beat-worker and migrator services.
REDIS_SSL_CERT_REQS="required"
REDIS_SSL_CA_CERTS=""

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://localhost:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880
# Signed URL expiration time in seconds (default: 3600 = 1 hour)
# Set to 30 for 30 seconds, 300 for 5 minutes, etc.
SIGNED_URL_EXPIRATION=3600

# set to 1 If using the pre-configured minio setup
USE_MINIO=0



# Email redirections and minio domain settings
WEB_URL="http://localhost:8000"

# Gunicorn Workers
GUNICORN_WORKERS=2

# Base URLs
ADMIN_BASE_URL="http://localhost:3001"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://localhost:3002"
SPACE_BASE_PATH="/spaces"

APP_BASE_URL="http://localhost:3000"
APP_BASE_PATH=""

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="secret-key"

# Hard delete files after days
HARD_DELETE_AFTER_DAYS=60

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"

# Instance telemetry is opt-in: nothing is sent unless an instance admin turns it on (God Mode > General).
# When it is on, usage counts (users, workspaces, projects, work items, ...) and workspace slugs are pushed
# to OTLP_ENDPOINT, which defaults to Plane's collector (https://telemetry.plane.so) when unset. Set it to your
# own OTLP collector to keep the data in-house. Do not set it to an empty string: an empty value is not "unset".
# OTLP_ENDPOINT="https://otel.example.com"
# OTLP_METRICS_PROTOCOL="grpc"  # or "http"
# METRICS_PUSH_INTERVAL_MINUTES=360

# Instance settings that can be seeded from the environment (all optional, all commented out).
# The API copies these into the instance configuration the FIRST time it starts; after that the values in
# God Mode (the admin app) win and changing them here has no effect. Sensible defaults are in brackets.

# Sign-in and workspaces
# ENABLE_SIGNUP=1                 # [1] let new users sign up
# ENABLE_EMAIL_PASSWORD=1         # [1] email and password sign-in
# ENABLE_MAGIC_LINK_LOGIN=0       # [0] sign-in with a one-time code sent by email (needs SMTP below)
# DISABLE_WORKSPACE_CREATION=0    # [0] set to 1 so only instance admins can create workspaces

# Email (SMTP). Needed for invitations, password resets and one-time sign-in codes.
# ENABLE_SMTP=0
# EMAIL_HOST=""
# EMAIL_PORT=587                  # [587]
# EMAIL_HOST_USER=""
# EMAIL_HOST_PASSWORD=""
# EMAIL_USE_TLS=1                 # [1]
# EMAIL_USE_SSL=0                 # [0]
# EMAIL_FROM=""                   # e.g. "Pi-Plane <no-reply@example.com>"

# OAuth sign-in (Google: see the OpenID Connect section below). Set IS_<PROVIDER>_ENABLED=1 together with the client id and secret.
# IS_GITHUB_ENABLED=0
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GITHUB_ORGANIZATION_ID=""       # optional: only members of this GitHub organization can sign in
# ENABLE_GITHUB_SYNC=0
#
# IS_GITLAB_ENABLED=0
# GITLAB_HOST="https://gitlab.com"
# GITLAB_CLIENT_ID=""
# GITLAB_CLIENT_SECRET=""
# ENABLE_GITLAB_SYNC=0
#
# IS_GITEA_ENABLED=0
# GITEA_HOST="https://gitea.example.com"
# GITEA_CLIENT_ID=""
# GITEA_CLIENT_SECRET=""
# ENABLE_GITEA_SYNC=0

# Single sign-on over OpenID Connect (provider list: plane/authentication/provider/oidc/registry.py).
# Redirect URI to register at the provider: <your URL>/auth/oidc/<entra|oidc>/callback/
# Microsoft Entra ID, one tenant only: people are bound by tenant + object id, so renaming a mailbox keeps the account.
# IS_ENTRA_ENABLED=0
# ENTRA_CLIENT_ID=""
# ENTRA_CLIENT_SECRET=""
# ENTRA_TENANT_ID=""              # the Directory (tenant) ID GUID, not "common" or a domain name
# ENTRA_ENABLE_SIGNUP=1           # [1] create accounts on first sign-in; 0 = only people who already have one or an invite
# ENTRA_LINK_EXISTING_ACCOUNTS=0      # [0] 1 = the next sign-in links an existing account with the same email (migration only)
# ENTRA_ALLOWED_EMAIL_DOMAINS=""  # optional, comma separated, e.g. "piatnica.com.pl"
# ENABLE_ENTRA_SYNC=0
#
# Google, over OpenID Connect (replaces the former IS_GOOGLE_ENABLED / GOOGLE_CLIENT_ID login).
# IS_GOOGLE_OIDC_ENABLED=0
# GOOGLE_OIDC_CLIENT_ID=""
# GOOGLE_OIDC_CLIENT_SECRET=""
# GOOGLE_OIDC_HOSTED_DOMAIN=""    # optional: only this Google Workspace domain (hd claim) can sign in
# GOOGLE_OIDC_ENABLE_SIGNUP=1
# GOOGLE_OIDC_LINK_EXISTING_ACCOUNTS=0      # [0] 1 = the next sign-in links an existing account with the same email (migration only)
# GOOGLE_OIDC_ALLOWED_EMAIL_DOMAINS=""
# ENABLE_GOOGLE_OIDC_SYNC=0
#
# Any other OpenID Connect provider (Keycloak, Okta, Authentik, ...): the email must be verified by the provider.
# IS_OIDC_ENABLED=0
# OIDC_ISSUER_URL=""              # https issuer; /.well-known/openid-configuration is read from it
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_DISPLAY_NAME="Single sign-on"
# OIDC_ENABLE_SIGNUP=1
# OIDC_LINK_EXISTING_ACCOUNTS=0      # [0] 1 = the next sign-in links an existing account with the same email (migration only)
# OIDC_ALLOWED_EMAIL_DOMAINS=""
# ENABLE_OIDC_SYNC=0

# AI features (optional)
# LLM_PROVIDER="openai"           # [openai]
# LLM_MODEL="gpt-4o-mini"         # [gpt-4o-mini]
# LLM_API_KEY=""

# Unsplash cover images (optional)
# UNSPLASH_ACCESS_KEY=""

# Throttle for sign-in, password change and email-change requests, counted per client IP (users behind one office or
# NAT address share it). The code default is 10/minute, which is what applies when you run the API directly. The root
# compose.yaml, the CLI and the all-in-one deployments use 1000/minute for the api service and rely on the proxy's own
# per-IP limit; set AUTHENTICATION_RATE_LIMIT in the root .env (compose) or here to change it.
# AUTHENTICATION_RATE_LIMIT="1000/minute"
# Number of reverse proxies in front of the API, used to read the client IP from
# X-Forwarded-For for rate limiting. Leave unset to keep the default behaviour.
# NUM_PROXIES=
