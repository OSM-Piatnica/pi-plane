# Backend
# SECRET_KEY (Django) is not listed here on purpose: ./setup.sh generates a random one and appends it below.
# For a real deployment set your own unique value; known placeholder values are refused at startup.
# Debug value for api server use it as 0 for production use
DEBUG=0
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100"

# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="plane-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_URL="redis://${REDIS_HOST}:6379/"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://localhost:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880
# Signed URL expiration time in seconds (default: 3600 = 1 hour)
# Set to 30 for 30 seconds, 300 for 5 minutes, etc.
SIGNED_URL_EXPIRATION=3600

# set to 1 If using the pre-configured minio setup
USE_MINIO=0



# Email redirections and minio domain settings
WEB_URL="http://localhost:8000"

# Gunicorn Workers
GUNICORN_WORKERS=2

# Base URLs
ADMIN_BASE_URL="http://localhost:3001"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://localhost:3002"
SPACE_BASE_PATH="/spaces"

APP_BASE_URL="http://localhost:3000"
APP_BASE_PATH=""

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="secret-key"

# Hard delete files after days
HARD_DELETE_AFTER_DAYS=60

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"

# Instance telemetry is opt-in: nothing is sent unless an instance admin turns it on (God Mode > General).
# When it is on, usage counts (users, workspaces, projects, work items, ...) and workspace slugs are pushed
# to OTLP_ENDPOINT, which defaults to Plane's collector (https://telemetry.plane.so) when unset. Set it to your
# own OTLP collector to keep the data in-house. Do not set it to an empty string: an empty value is not "unset".
# OTLP_ENDPOINT="https://otel.example.com"
# OTLP_METRICS_PROTOCOL="grpc"  # or "http"
# METRICS_PUSH_INTERVAL_MINUTES=360

# Instance settings that can be seeded from the environment (all optional, all commented out).
# The API copies these into the instance configuration the FIRST time it starts; after that the values in
# God Mode (the admin app) win and changing them here has no effect. Sensible defaults are in brackets.

# Sign-in and workspaces
# ENABLE_SIGNUP=1                 # [1] let new users sign up
# ENABLE_EMAIL_PASSWORD=1         # [1] email and password sign-in
# ENABLE_MAGIC_LINK_LOGIN=0       # [0] sign-in with a unique code sent by email (needs SMTP below)
# DISABLE_WORKSPACE_CREATION=0    # [0] set to 1 so only instance admins can create workspaces

# Email (SMTP). Needed for invitations, password resets and magic links.
# ENABLE_SMTP=0
# EMAIL_HOST=""
# EMAIL_PORT=587                  # [587]
# EMAIL_HOST_USER=""
# EMAIL_HOST_PASSWORD=""
# EMAIL_USE_TLS=1                 # [1]
# EMAIL_USE_SSL=0                 # [0]
# EMAIL_FROM=""                   # e.g. "Pi-Plane <no-reply@example.com>"

# OAuth sign-in. Set IS_<PROVIDER>_ENABLED=1 together with the client id and secret.
# IS_GOOGLE_ENABLED=0
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# ENABLE_GOOGLE_SYNC=0            # refresh the user's name and avatar from the provider on every later sign-in
#
# IS_GITHUB_ENABLED=0
# GITHUB_CLIENT_ID=""
# GITHUB_CLIENT_SECRET=""
# GITHUB_ORGANIZATION_ID=""       # optional: only members of this GitHub organization can sign in
# ENABLE_GITHUB_SYNC=0
#
# IS_GITLAB_ENABLED=0
# GITLAB_HOST="https://gitlab.com"
# GITLAB_CLIENT_ID=""
# GITLAB_CLIENT_SECRET=""
# ENABLE_GITLAB_SYNC=0
#
# IS_GITEA_ENABLED=0
# GITEA_HOST="https://gitea.example.com"
# GITEA_CLIENT_ID=""
# GITEA_CLIENT_SECRET=""
# ENABLE_GITEA_SYNC=0

# AI features (optional)
# LLM_PROVIDER="openai"           # [openai]
# LLM_MODEL="gpt-4o-mini"         # [gpt-4o-mini]
# LLM_API_KEY=""

# Unsplash cover images (optional)
# UNSPLASH_ACCESS_KEY=""
