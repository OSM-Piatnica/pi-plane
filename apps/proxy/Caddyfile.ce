{
    {$CERT_EMAIL}
    acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
    {$CERT_ACME_DNS}
    auto_https off

    servers {
        max_header_size 25MB
        client_ip_headers X-Forwarded-For X-Real-IP
        trusted_proxies static {$TRUSTED_PROXIES:0.0.0.0/0}
    }
}

(plane_proxy) {
    request_body {
        max_size {$FILE_SIZE_LIMIT}
    }

    # Przekierowania dla ujednolicenia ścieżek
    redir /spaces /spaces/ permanent
    redir /god-mode /god-mode/ permanent

    # Frontend - Spaces
    reverse_proxy /spaces/* space:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Frontend - Admin / God-mode
    reverse_proxy /god-mode/* admin:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Live Server (Websockety)
    reverse_proxy /live/* live:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
        # Wsparcie dla Websocketów
        header_up Upgrade {+Upgrade}
        header_up Connection {+Connection}
    }

    # Backend API i Auth
    reverse_proxy /api/* api:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    reverse_proxy /auth/* api:8000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    reverse_proxy /static/* api:8000 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Minio / Storage
    reverse_proxy /{$BUCKET_NAME}/* plane-minio:9000 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
    }
    
    reverse_proxy /{$BUCKET_NAME} plane-minio:9000 {
        header_up Host {host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Główna aplikacja (Web)
    reverse_proxy web:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

{$SITE_ADDRESS} {
    tls /certs/cert.pem /certs/key.pem
    import plane_proxy
}

