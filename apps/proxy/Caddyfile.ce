(plane_proxy) {
	# Per-client-IP flood guard. Everyone behind one office IP shares this bucket,
	# so keep it well above the whole office's traffic. Needs the caddy-ratelimit plugin.
	rate_limit {
		zone per_ip {
			key {client_ip}
			events {$RATE_LIMIT_PER_IP_PER_MIN:50000}
			window 1m
		}
	}

	request_body {
		max_size {$FILE_SIZE_LIMIT}
	}

  redir /spaces /spaces/ permanent
	reverse_proxy /spaces/* space:3000

  redir /god-mode /god-mode/ permanent
	reverse_proxy /god-mode/* admin:3000
	
	reverse_proxy /live/* live:3000

	reverse_proxy /api/* api:8000

	reverse_proxy /auth/* api:8000

	reverse_proxy /static/* api:8000

	reverse_proxy /{$BUCKET_NAME}/* plane-minio:9000
	reverse_proxy /{$BUCKET_NAME} plane-minio:9000

	reverse_proxy /* web:3000
}

{
	order rate_limit before basicauth
	{$CERT_EMAIL}
	acme_ca {$CERT_ACME_CA:https://acme-v02.api.letsencrypt.org/directory} 
	{$CERT_ACME_DNS}
	servers {
		max_header_size 25MB
		client_ip_headers X-Forwarded-For X-Real-IP
		# Only peers in this range may set X-Forwarded-For/X-Real-IP; for anyone else Caddy uses the
		# connecting address. The default is the private ranges: a load balancer inside your network is
		# trusted, a client on the internet is not and cannot spoof its address (or the per-IP rate
		# limit). Behind a CDN or a load balancer with a public address, set TRUSTED_PROXIES to its range.
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
	}
}

{$SITE_ADDRESS} {
	import plane_proxy
}