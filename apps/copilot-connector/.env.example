# Do uruchamiania konektora POZA stosem Pi-Plane (lokalnie, testy). Skopiuj do .env i uzupelnij.
# W stosie Pi-Plane wartosci ustawia sie w plane.env jako COPILOT_... (docs/copilot-connector.md).
# Plik .env zawiera sekrety - nie wysylaj go nikomu i nie wrzucaj do repozytorium.

# Aplikacja w Entra ID (uprawnienia aplikacyjne: ExternalConnection.ReadWrite.OwnedBy,
# ExternalItem.ReadWrite.OwnedBy, User.Read.All)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

GRAPH_CONNECTION_ID=piplaneconnector
GRAPH_CONNECTION_NAME=Pi-Plane Graph Connector

# Publiczny adres Plane (linki do zadan) i slug workspace'u
PLANE_BASE_URL=https://plane.example.com
PLANE_WORKSPACE_SLUG=
# Bot token z God Mode -> Bot tokens (docs/bot-tokens.md): widzi wszystkie projekty, tylko odczyt
PLANE_API_TOKEN=
# Gdy serwer Plane wysyla niekompletny lancuch certyfikatow: plik .pem z certyfikatem posrednim i glownym
#PLANE_SSL_CERT_PATH=plane_ca_chain.pem

# precise  - zadanie w Copilocie widza tylko osoby do niego przypisane (wprost albo przez grupe),
#            zadanie bez przypisanych osob - lider projektu
# project  - wszyscy czlonkowie projektu (jak w Plane)
# everyone - wszyscy w firmie
DEFAULT_ACL_TYPE=precise

# Nazwy statusow i priorytetow wysylane do Copilota - tak jak pokazuje je interfejs Plane.
# all (domyslnie) - kazdy jezyk Plane; mozna zawezic, np. pl,en
#PLANE_LABEL_LANGUAGES=all
