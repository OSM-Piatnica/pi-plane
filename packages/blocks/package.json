{
  "name": "@plane/blocks",
  "version": "1.3.1",
  "private": true,
  "description": "Composite components and Plane-specific building blocks, built on top of @makeplane/propel primitives",
  "license": "AGPL-3.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./auth": "./dist/auth/index.js",
    "./breadcrumb": "./dist/breadcrumb/index.js",
    "./card": "./dist/card/index.js",
    "./charts/area-chart": "./dist/charts/area-chart/index.js",
    "./charts/bar-chart": "./dist/charts/bar-chart/index.js",
    "./charts/line-chart": "./dist/charts/line-chart/index.js",
    "./charts/pie-chart": "./dist/charts/pie-chart/index.js",
    "./charts/radar-chart": "./dist/charts/radar-chart/index.js",
    "./charts/tree-map": "./dist/charts/tree-map/index.js",
    "./common": "./dist/common/index.js",
    "./context-menu": "./dist/context-menu/index.js",
    "./dialog": "./dist/dialog/index.js",
    "./emoji-icon-picker": "./dist/emoji-icon-picker/index.js",
    "./emoji-icon-picker/data": "./dist/emoji-icon-picker/data.js",
    "./emoji-reaction": "./dist/emoji-reaction/index.js",
    "./empty-state": "./dist/empty-state/index.js",
    "./icons": "./dist/icons/index.js",
    "./layout": "./dist/layout/index.js",
    "./pill-button": "./dist/pill-button/index.js",
    "./portal": "./dist/portal/index.js",
    "./property-select": "./dist/property-select/index.js",
    "./select": "./dist/select/index.js",
    "./skeleton": "./dist/skeleton/index.js",
    "./spinner": "./dist/spinner/index.js",
    "./toast": "./dist/toast/index.js",
    "./types": "./dist/types/index.js",
    "./utils": "./dist/utils/index.js",
    "./virtual-list": "./dist/virtual-list/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown --watch --no-clean",
    "build": "tsdown",
    "test": "vitest run --project=unit --project=dom",
    "check:lint": "oxlint .",
    "check:types": "tsc --noEmit",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt .",
    "clean": "rm -rf .turbo && rm -rf .next && rm -rf node_modules && rm -rf dist"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "catalog:",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "catalog:",
    "@base-ui/react": "1.6.0",
    "@makeplane/propel": "0.7.3",
    "@plane/constants": "workspace:*",
    "@plane/hooks": "workspace:*",
    "@plane/i18n": "workspace:*",
    "@plane/types": "workspace:*",
    "@plane/utils": "workspace:*",
    "@tanstack/react-virtual": "^3.13.12",
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "frimousse": "^0.3.0",
    "lodash-es": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "recharts": "^2.15.4",
    "use-font-face-observer": "^1.3.0"
  },
  "devDependencies": {
    "@plane/tailwind-config": "workspace:*",
    "@plane/typescript-config": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.1",
    "@types/lodash-es": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "23.2.0",
    "mobx": "catalog:",
    "mobx-react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
