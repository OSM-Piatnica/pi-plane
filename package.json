{
  "name": "plane",
  "version": "1.3.1-pi.2",
  "private": true,
  "description": "Open-source project management that unlocks customer value",
  "license": "AGPL-3.0",
  "repository": "https://github.com/makeplane/plane.git",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency=18",
    "start": "turbo run start",
    "clean": "turbo run clean && rm -rf .turbo && rm -rf .next && rm -rf node_modules && rm -rf dist",
    "fix": "turbo run fix",
    "fix:format": "turbo run fix:format",
    "fix:lint": "turbo run fix:lint",
    "check": "turbo run check",
    "check:lint": "turbo run check:lint",
    "check:format": "turbo run check:format",
    "check:types": "turbo run check:types",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "oxfmt": "0.35.0",
    "oxlint": "1.51.0",
    "turbo": "2.9.18"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,cjs,mjs,cts,mts,json,css,md}": [
      "pnpm exec oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{js,jsx,ts,tsx,cjs,mjs,cts,mts}": [
      "pnpm exec oxlint --fix --deny-warnings"
    ],
    "apps/api/**/*.py": [
      ".husky/ruff-staged.sh"
    ]
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "pnpm": {
    "overrides": {
      "express": "catalog:",
      "react": "catalog:",
      "react-dom": "catalog:",
      "react-is": "catalog:",
      "@types/react": "catalog:",
      "@types/react-dom": "catalog:",
      "@react-router/serve>express": "^5.2.1",
      "router>path-to-regexp": "^8.4.2",
      "mdast-util-to-hast": "13.2.1",
      "valibot": "1.5.0",
      "glob": "11.1.0",
      "brace-expansion": "5.0.12",
      "nanoid": "3.3.20",
      "esbuild": "0.28.2",
      "@babel/helpers": "7.26.10",
      "@babel/runtime": "7.26.10",
      "chokidar": "3.6.0",
      "prosemirror-view": "1.42.6",
      "@types/express": "4.17.23",
      "typescript": "catalog:",
      "vite": "catalog:",
      "qs": "6.16.0",
      "diff": "5.2.2",
      "webpack": "5.104.1",
      "lodash-es": "catalog:",
      "lodash": "4.18.1",
      "markdown-it": "14.3.2",
      "rollup": "4.59.0",
      "minimatch@3": "3.1.4",
      "minimatch@10": "10.2.3",
      "serialize-javascript": "7.0.5",
      "ajv@6": "6.14.0",
      "ajv@8": "8.18.0",
      "undici@7": "7.30.0",
      "flatted": "3.4.2",
      "picomatch": "2.3.2",
      "yaml@1": "1.10.3",
      "yaml@2": "2.8.3",
      "path-to-regexp": "0.1.13",
      "defu": "6.1.5",
      "postcss": "8.5.30",
      "axios": "catalog:",
      "follow-redirects": "1.16.0",
      "uuid": "catalog:",
      "tmp": "0.2.7",
      "form-data": "4.0.6",
      "morgan": "1.12.1",
      "ws@8": "8.22.0",
      "ws@7": "7.5.13",
      "linkify-it": "5.0.2",
      "body-parser": "1.20.8",
      "js-yaml@4": "4.3.2",
      "sanitize-html": "2.18.1",
      "compression": "1.8.2",
      "proxy-addr": "2.0.8",
      "source-map-js": "1.2.2",
      "@babel/core": "7.29.7",
      "browserslist": "4.29.3",
      "baseline-browser-mapping": "2.11.28",
      "postcss-selector-parser@7": "7.1.6",
      "postcss-selector-parser@6": "6.1.4",
      "tinypool": "2.2.0",
      "webpack-dev-middleware@7": "7.4.6",
      "fast-uri@3": "3.1.8",
      "prosemirror-model": "1.25.12"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "turbo"
    ],
    "ignoredBuiltDependencies": [
      "sharp"
    ]
  }
}
